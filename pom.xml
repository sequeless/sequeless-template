<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only. Never released or deployed (spec 2, §1 and §6).
  Modules take their parent from sequeless-build-parent, not from this POM, so the
  repository entry and the junit-bom import are repeated in template-core/pom.xml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.sequeless</groupId>
  <artifactId>sequeless-template</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>sequeless-template</name>
  <description>Placeholder repo: copy this to start a new Sequeless repo.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <modules>
    <module>template-core</module>
  </modules>

  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>
</project>
